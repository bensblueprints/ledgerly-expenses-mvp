# Ledgerly configuration
# Copy to .env (or set as environment variables) — all optional.

# Port the server listens on
PORT=5335

# Password for the app. CHANGE THIS before deploying publicly.
ADMIN_PASSWORD=admin

# Where the SQLite database + receipt images live (defaults to ./data)
# DATA_DIR=/var/lib/ledgerly

# SQLite file path override (defaults to <DATA_DIR>/app.db)
# DB_PATH=/var/lib/ledgerly/app.db
